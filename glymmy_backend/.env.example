# ─── Application ───
APP_NAME=Glymmy API
APP_VERSION=0.1.0
DEBUG=true

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── LLM Provider ───
# Options: ollama_gemma | anthropic
LLM_PROVIDER=ollama_gemma

# Ollama (default — local, free, multimodal via Gemma 4)
# Gemma 4 E4B: ~4.5B effective params, 256K context, text+vision, Apache 2.0
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Anthropic (production option)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Data Providers ───
# CGM: glucobench | nightscout
CGM_PROVIDER=glucobench
# Labs: mimic
LABS_PROVIDER=mimic
# Storage: memory | neon
STORAGE_PROVIDER=memory

# ─── Datasets ───
DATASET_DIR=../notebooks/datasets

# ─── Vector Store (RAG) ───
# Mode: embedded (local file) | server (remote ChromaDB via HTTP)
CHROMA_MODE=embedded
CHROMA_HOST=http://localhost:8100
CHROMA_PERSIST_DIR=./chroma_data

# ─── Demo Mode ───
# DEMO_MODE=true skips auth, auto-resolves to first user
DEMO_MODE=true
# AUTO_SEED=true seeds synthetic wearable data on startup if storage is empty
AUTO_SEED=true

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000"]

# ─── Clerk Authentication (optional — leave empty for demo mode) ───
# Get these at https://dashboard.clerk.com
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
